{
  "name": "@seneca/eventbrite-provider",
  "version": "1.0.0",
  "main": "dist/eventbrite-provider.js",
  "type": "commonjs",
  "types": "dist/eventbrite-provider.d.ts",
  "description": "Seneca entity provider for the Eventbrite API.",
  "homepage": "https://github.com/senecajs/seneca-eventbrite-provider",
  "keywords": [
    "seneca",
    "eventbrite-provider"
  ],
  "author": "Richard Rodger - richardrodger.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/seneca-eventbrite-provider.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "jest --coverage",
    "test-some": "jest -t",
    "test-watch": "jest --coverage --watchAll",
    "watch": "tsc -w -d",
    "build": "tsc -d",
    "doc": "seneca-doc",
    "clean": "rm -rf node_modules yarn.lock package-lock.json",
    "reset": "npm run clean && npm i && npm test",
    "repo-tag": "REPO_VERSION=`node -e \"console.log(require('./package').version)\"` && echo TAG: v$REPO_VERSION && git commit -a -m v$REPO_VERSION && git push && git tag v$REPO_VERSION && git push --tags;",
    "repo-publish": "npm run clean && npm i && npm run repo-publish-quick",
    "repo-publish-quick": "npm run build && npm run test && npm run repo-tag && npm publish --access public --registry https://registry.npmjs.org "
  },
  "license": "MIT",
  "files": [
    "dist",
    "src/**/*.ts",
    "LICENSE",
    "CHANGES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@seneca/doc": "^9.0.0",
    "@seneca/entity": "^29.0.0",
    "@seneca/provider": "^5.0.0",
    "@types/jest": "^27.0.3",
    "@types/lodash": "^4.14.178",
    "@types/node": "^24.13.3",
    "esbuild": "^0.14.6",
    "esbuild-jest": "^0.5.0",
    "jest": "^27.4.5",
    "seneca": "^4.0.0",
    "seneca-msg-test": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@seneca/entity": "^29.0.0",
    "@seneca/provider": "^5.0.0",
    "seneca": "^4.0.0"
  },
  "dependencies": {
    "eventbrite": "^1.3.0",
    "lodash": "^4.17.21"
  }
}
